# bazelrc (applies to all invocations of bazel or bazelisk)
common --enable_bzlmod
common --experimental_cc_static_library
build --config=clippy

# Don't try to find a C++ compiler on the local machine.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
# Use nightly rustc by default
common --@rules_rust//rust/toolchain/channel=nightly

build --incompatible_enable_cc_toolchain_resolution
build --incompatible_enable_proto_toolchain_resolution
build --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc=true
build --@toolchains_llvm_bootstrapped//config:experimental_stub_libgcc_s=true
build --copt=-Wno-implicit-function-declaration
build --host_copt=-Wno-implicit-function-declaration
build --incompatible_strict_action_env
build --strip=always
build -c opt

try-import %workspace%/google_internal/.bazelrc

build:run_all_tests --cache_test_results=no

build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks

coverage --cache_test_results=no
coverage --features=-coverage
