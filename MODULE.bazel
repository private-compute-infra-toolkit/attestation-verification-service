"""oak/attestation-verification-service"""

module(
    name = "attestation-verification-service",
    version = "0.0.1",
)

bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_rust_prost", version = "0.70.0")
bazel_dep(name = "tar.bzl", version = "0.6.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251211-05f65958")
single_version_override(
    module_name = "googleapis",
    version = "0.0.0-20251111-659ea6e9",
)

single_version_override(
    module_name = "rules_apple",
    version = "3.16.0",
)

bazel_dep(name = "toolchains_llvm_bootstrapped", version = "0.2.4")

# Configure hermetic C++ toolchain
register_toolchains(
    "@toolchains_llvm_bootstrapped//toolchain:linux_amd64",
)

# Register the Rust toolchain.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.86.0"],  # Same as harvest_rustc_linux.
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

register_toolchains(
    "@//:prost_toolchain",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "protoc-gen-prost",
    version = "0.5.0",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.spec(
    package = "protoc-gen-tonic",
    version = "0.5.0",
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.spec(
    package = "rcgen",
    version = "0.14.7",
)
crate.spec(
    features = ["pem"],
    package = "x509-cert",
    version = "0.2",
)
crate.spec(
    features = [
        "p256",
        "rsa",
        "sha2",
        "x509",
        "pem",
    ],
    package = "x509-verify",
    version = "0.4.8",
)
crate.spec(
    package = "thiserror",
    version = "1.0",
)
crate.spec(
    package = "glob",
    version = "0.3.3",
)
crate.from_specs(
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(crate, "crates")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:68db2bf2b975ff277c9b2b569c327e47e2824e2c143f4dfe7c4027b15ff2f931",
    image = "gcr.io/distroless/cc-debian13",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(oci, "distroless_cc", "distroless_cc_linux_amd64", "distroless_cc_linux_arm64")

bazel_dep(name = "boringssl", version = "0.20250415.0")
archive_override(
    module_name = "boringssl",
    patches = [
        "//third_party/boringssl:boringssl.patch",
    ],
    sha256 = "d1c599485fd1919d75ea2925af5fff81c1d5b21ab2f0d41fee1f788b1d917159",
    strip_prefix = "boringssl-0.20260616.0",
    urls = ["https://github.com/google/boringssl/releases/download/0.20260616.0/boringssl-0.20260616.0.tar.gz"],
)

# TODO: b/496109194 - Delete dependencies introduced to AVS repo specifically for Oak.
bazel_dep(name = "oak", version = "0.0.0")
archive_override(
    module_name = "oak",
    sha256 = "700268138b1d32c75c9a63fd6fd0d95ba292d39b0310821693932d6aed27aeee",
    strip_prefix = "oak-973bf96c8521523d360a90da718a7794cfe1c98c",
    url = "https://github.com/project-oak/oak/archive/973bf96c8521523d360a90da718a7794cfe1c98c.tar.gz",
)

oak_aliased_crates = use_extension(
    "@oak//bazel/crates:extensions.bzl",
    "aliased_crates_repository",
)
use_repo(oak_aliased_crates, "oak_crates_index")

bazel_dep(name = "tca-sdk", version = "0.0.0")
local_path_override(
    module_name = "tca-sdk",
    path = "third_party/tca-sdk",
)

bazel_dep(name = "pcit_api", version = "0.0.0")
local_path_override(
    module_name = "pcit_api",
    path = "third_party/tca-sdk/api",
)

single_version_override(
    module_name = "grpc",
    patches = ["//third_party/grpc:grpc_python_versions.patch"],
    version = "1.78.0",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.13",
)
