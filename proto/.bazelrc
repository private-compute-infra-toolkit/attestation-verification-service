common --enable_bzlmod
common --experimental_cc_static_library
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

build --incompatible_enable_cc_toolchain_resolution
build --incompatible_enable_proto_toolchain_resolution
build --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc=true
build --@toolchains_llvm_bootstrapped//config:experimental_stub_libgcc_s=true
build --incompatible_strict_action_env

try-import %workspace%/../google_internal/.bazelrc
